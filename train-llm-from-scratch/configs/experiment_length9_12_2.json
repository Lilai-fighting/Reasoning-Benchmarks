{
  "model": {
    "vocab_size": 50304,
    "context_length": 256,
    "n_embed": 256,
    "n_head": 8,
    "n_blocks": 6,
    "device": "cuda",
    "amp_dtype": "bf16",
    "compile": false
  },
  "data": {
    "path": "ephemeral/data/length9_12_train_42.h5",
    "batch_size": 8,
    "num_workers": 0,
    "pin_memory": true
  },
  "training": {
    "seeds": [
      42
    ],
    "epochs": 20,
    "grad_accum": 4,
    "lr": 0.0003,
    "min_lr": 3e-05,
    "warmup_ratio": 0.05,
